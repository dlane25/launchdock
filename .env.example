# Public URL of this server (used in OTA manifests, share links and the expo-updates URL).
PUBLIC_URL=https://ship.4aro.com

# 32-byte key that encrypts the credentials vault. Generate: openssl rand -hex 32
# Back this up — losing it means losing every stored keystore/certificate.
MASTER_KEY=

# Session signing secret. Generate: openssl rand -hex 32
JWT_SECRET=

# Shared secret build workers use to authenticate. Generate: openssl rand -hex 24
WORKER_TOKEN=

POSTGRES_PASSWORD=change-me

# Let anyone sign up (otherwise only the first user self-registers; admins invite the rest).
ALLOW_REGISTRATION=false

# Storage: "local" (Docker volume) or "s3" (AWS S3 / Cloudflare R2 / any S3-compatible).
STORAGE_DRIVER=local
# S3_BUCKET=launchdock
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional: start a GitHub Actions macOS runner on demand when iOS jobs are queued.
# GITHUB_DISPATCH_REPO=dlane25/launchdock
# GITHUB_DISPATCH_TOKEN=github_pat_...        # fine-grained PAT, "Actions: Read and write" on that repo
# GITHUB_DISPATCH_WORKFLOW=launchdock-worker.yml
# GITHUB_DISPATCH_PLATFORMS=ios

# Limits
MAX_SOURCE_MB=500
MAX_ARTIFACT_MB=2048
LOG_RETENTION_DAYS=30
